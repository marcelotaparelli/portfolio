---
import { site } from '../data/site';
import { pathFor, type Locale } from '../i18n/routes';
import { t } from '../i18n/translations';
import Mark from './Mark.astro';
import CvLink from './CvLink.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = t(locale);
---

<footer class="site-footer">
  <div class="container footer-top">
    <div>
      <a class="brand" href={pathFor('home', locale)}>
        <Mark />
        <span>
          Marcelo Taparelli<span class="brand-dot">.</span>
        </span>
      </a>
      <p>{text.footerNote}</p>
    </div>
    <nav
      class="footer-links"
      aria-label={
        locale === 'en'
          ? 'Social links and résumé'
          : 'Redes profissionais e currículo'
      }
    >
      <a href={site.github}>GitHub</a>
      <a href={site.linkedin}>LinkedIn</a>
      <a href={`mailto:${site.email}`}>Email</a>
      <CvLink locale={locale} />
    </nav>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} Marcelo Taparelli</span>
    <span lang="en">Software Engineering · Applied AI · Product</span>
  </div>
</footer>
