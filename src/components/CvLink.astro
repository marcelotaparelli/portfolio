---
import { file as bunFile } from 'bun';
import { createHash } from 'node:crypto';
import { cv } from '../data/site';
import { t } from '../i18n/translations';
import type { Locale } from '../i18n/routes';
import Arrow from './Arrow.astro';
interface Props {
  locale: Locale;
  variant?: 'hero';
}
const { locale, variant } = Astro.props;
const file = cv[locale];
const available =
  file.reviewed &&
  (await bunFile(`${process.cwd()}/public${file.path}`).exists());
const version = available
  ? createHash('sha256')
      .update(new Uint8Array(await bunFile(`public${file.path}`).arrayBuffer()))
      .digest('hex')
  : '';
---

{available && (
  <a
    class={variant === 'hero' ? 'cv-link-hero' : 'text-link'}
    href={`${file.path}?v=${version}`}
    download
  >
    {t(locale).cv}
    {variant === 'hero' ? (
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 3v12m-5-5 5 5 5-5M5 16v5h14v-5" />
      </svg>
    ) : (
      <>
        <span class="file-label">PDF</span>
        <Arrow direction="diagonal" />
      </>
    )}
  </a>
)}

<style>
  @font-face {
    font-family: 'Inter CV hero';
    src: url('@fontsource/inter/files/inter-latin-300-normal.woff2')
      format('woff2');
    font-style: normal;
    font-weight: 300;
    font-display: swap;
  }

  .cv-link-hero {
    display: flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    min-height: 44px;
    margin-top: 12px;
    color: var(--color-muted);
    font-family: 'Inter CV hero', 'Inter fallback', sans-serif;
    font-size: 14px;
    font-weight: 300;
  }

  .cv-link-hero:hover {
    text-decoration: underline;
  }
</style>
