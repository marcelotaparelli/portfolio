---
import { file as bunFile } from 'bun';
import { createHash } from 'node:crypto';
import { cv } from '../data/site';
import { t } from '../i18n/translations';
import type { Locale } from '../i18n/routes';
import Arrow from './Arrow.astro';
interface Props {
  locale: Locale;
  variant?: 'hero';
}
const { locale, variant } = Astro.props;
const file = cv[locale];
const available =
  file.reviewed &&
  (await bunFile(`${process.cwd()}/public${file.path}`).exists());
const version = available
  ? createHash('sha256')
      .update(new Uint8Array(await bunFile(`public${file.path}`).arrayBuffer()))
      .digest('hex')
  : '';
---

{available && (
  <a
    class={variant === 'hero' ? 'cv-link-hero' : 'text-link'}
    href={`${file.path}?v=${version}`}
    download
  >
    {t(locale).cv}
    {variant !== 'hero' && (
      <>
        <span class="file-label">PDF</span>
        <Arrow direction="diagonal" />
      </>
    )}
  </a>
)}

<style>
  @font-face {
    font-family: 'Inter CV hero';
    src: url('@fontsource/inter/files/inter-latin-500-normal.woff2')
      format('woff2');
    font-style: normal;
    font-weight: 500;
    font-display: swap;
  }

  .cv-link-hero {
    display: flex;
    align-items: center;
    width: fit-content;
    min-height: 44px;
    margin-top: 12px;
    color: var(--color-accent);
    font-family: 'Inter CV hero', 'Inter fallback', sans-serif;
    font-size: 16px;
    font-weight: 500;
  }

  .cv-link-hero:hover {
    text-decoration: underline;
  }

  @media (max-width: 760px) {
    .cv-link-hero {
      font-size: 14px;
    }
  }
</style>
