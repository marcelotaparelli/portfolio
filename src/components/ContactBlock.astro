---
import { site } from '../data/site';
import { t } from '../i18n/translations';
import type { Locale } from '../i18n/routes';
import Arrow from './Arrow.astro';
interface Props {
  locale: Locale;
  standalone?: boolean;
}
const { locale, standalone = false } = Astro.props;
const text = t(locale).contact;
const Heading = standalone ? 'h1' : 'h2';
---

<section
  class:list={['contact-section', { 'contact-standalone': standalone }]}
  aria-labelledby="contact-title"
>
  <div class="container contact-inner">
    <p class="eyebrow">
      <span class="status-dot" aria-hidden="true"></span>
      {text.eyebrow}
    </p>
    <Heading id="contact-title" class="contact-title preserve-lines">
      {text.title}
    </Heading>
    <p class="section-description">{text.description}</p>
    <a class="email-link" href={`mailto:${site.email}`}>
      {site.email}
      <Arrow direction="diagonal" />
    </a>
    <a class="text-link" href={site.linkedin}>
      {text.linkedin}
      <Arrow direction="diagonal" />
    </a>
  </div>
</section>
