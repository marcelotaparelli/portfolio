---
import type { Locale } from '../i18n/routes';
import { t } from '../i18n/translations';
interface Props {
  locale: Locale;
  variant?: 'default' | 'about';
}
const { locale, variant = 'default' } = Astro.props;
const text = t(locale).method;
const steps = [
  'BUSINESS PROBLEM',
  'DOMAIN MODEL',
  'ARCHITECTURE',
  'CONSTRAINTS',
  'AI / AGENT ORCHESTRATION',
  'VERIFICATION',
  'SECURITY',
  'PRODUCTION',
  'MEASUREMENT',
  'IMPROVEMENT',
];
---

<section
  class:list={[
    'container section engineering-method',
    { 'engineering-method--about': variant === 'about' },
  ]}
  aria-labelledby="method-title"
>
  <div class="method-intro">
    <p class="eyebrow">{text.eyebrow}</p>
    <h2 id="method-title">{text.title}</h2>
    <p class="section-description">{text.description}</p>
    <p class="section-description">{text.scope}</p>
  </div>
  <ol class="method-flow" lang="en">
    {steps.map((step, index) => (
      <li>
        <span class="method-step">
          <span class="method-number" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <span>{step}</span>
        </span>
        {index < steps.length - 1 && (
          <span class="method-arrow" aria-hidden="true">
            ↓
          </span>
        )}
      </li>
    ))}
  </ol>
</section>

<style>
  .engineering-method {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    border-top: 1px solid var(--color-line);
  }
  .method-intro .eyebrow {
    margin-bottom: 24px;
  }
  .method-intro p.section-description {
    margin-top: 24px;
  }
  .method-flow {
    list-style: none;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .method-step {
    display: flex;
    gap: 20px;
    align-items: baseline;
    padding: 10px 16px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .method-number {
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }
  .method-arrow {
    display: block;
    margin-left: 24px;
    color: var(--color-accent);
    line-height: 1.4;
  }
  .engineering-method--about {
    grid-template-columns: 1fr 1.65fr;
    gap: 90px;
    padding-block: 64px;
  }
  .engineering-method--about h2 {
    max-width: 320px;
    font-size: 28px;
    line-height: 1.25;
  }
  .engineering-method--about .eyebrow {
    margin-bottom: 16px;
  }
  .engineering-method--about .section-description {
    margin-top: 20px;
    font-size: 15px;
    line-height: 1.8;
  }
  .engineering-method--about .method-flow li {
    position: relative;
  }
  .engineering-method--about .method-flow li + li {
    margin-top: 12px;
  }
  .engineering-method--about .method-flow li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 14px;
    top: 28px;
    bottom: -12px;
    border-left: 1px solid var(--color-line);
  }
  .engineering-method--about .method-step {
    position: relative;
    align-items: center;
    gap: 20px;
    min-height: 28px;
    padding: 0;
    border: 0;
    background: transparent;
    font-size: 13px;
    letter-spacing: 0.06em;
  }
  .engineering-method--about .method-number {
    display: grid;
    place-items: center;
    width: 29px;
    height: 29px;
    flex-shrink: 0;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    background: var(--color-navy);
    color: var(--color-muted);
    font-size: 10px;
    letter-spacing: 0;
  }
  .engineering-method--about .method-flow li:nth-child(5) .method-step,
  .engineering-method--about .method-flow li:nth-child(9) .method-step {
    color: var(--color-accent);
  }
  .engineering-method--about .method-arrow {
    display: none;
  }
  @media (max-width: 760px) {
    .engineering-method {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .method-step {
      gap: 12px;
      padding-inline: 12px;
      font-size: 12px;
    }
    .engineering-method--about {
      gap: 28px;
      padding-block: 42px;
    }
    .engineering-method--about .method-step {
      gap: 16px;
    }
  }
</style>
