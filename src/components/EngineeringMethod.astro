---
import type { Locale } from '../i18n/routes';
import { t } from '../i18n/translations';
interface Props {
  locale: Locale;
  variant?: 'default' | 'about';
}
const { locale, variant = 'default' } = Astro.props;
const text = t(locale).method;
const steps = [
  'BUSINESS PROBLEM',
  'DOMAIN MODEL',
  'ARCHITECTURE',
  'CONSTRAINTS',
  'AI / AGENT ORCHESTRATION',
  'VERIFICATION',
  'SECURITY',
  'PRODUCTION',
  'MEASUREMENT',
  'IMPROVEMENT',
];
---

<section
  class:list={[
    'container section engineering-method',
    { 'engineering-method--about': variant === 'about' },
  ]}
  aria-labelledby="method-title"
>
  <div class="method-intro">
    <p class="eyebrow">{text.eyebrow}</p>
    <h2 id="method-title">{text.title}</h2>
    <p class="section-description">{text.description}</p>
    <p class="section-description method-scope">{text.scope}</p>
  </div>
  <ol class="method-flow" role="list" lang="en">
    {steps.map((step, index) => (
      <li class:list={['method-step', { 'method-step--ai': index === 4 }]}>
        <span class="method-number" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </span>
        <span class="method-node" aria-hidden="true" />
        <span class="method-label">
          {step === 'AI / AGENT ORCHESTRATION' ? (
            <>
              AI / AGENT <wbr />
              ORCHESTRATION
            </>
          ) : (
            step
          )}
        </span>
        {index === 8 && (
          <svg
            class="method-feedback"
            width="32"
            height="116"
            viewBox="0 0 32 116"
            fill="none"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M4 87H20Q28 87 28 79V37Q28 29 20 29H4M9 24L4 29L9 34" />
          </svg>
        )}
      </li>
    ))}
  </ol>
</section>

<style>
  .engineering-method {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(48px, 6vw, 88px);
    border-top: 1px solid var(--color-line);
  }
  .engineering-method--about {
    padding-block: 64px;
  }
  .method-intro {
    min-width: 0;
  }
  .method-intro .eyebrow {
    margin-bottom: 24px;
  }
  .method-intro h2 {
    max-width: 460px;
    font-size: clamp(32px, 3vw, 42px);
    line-height: 1.18;
    text-wrap: balance;
  }
  .method-intro p.section-description {
    max-width: 440px;
    margin-top: 28px;
    font-size: 16px;
    line-height: 1.85;
  }
  .method-intro p.method-scope {
    margin-top: 24px;
    padding-left: 18px;
    border-left: 1px solid var(--color-line);
    font-size: 14px;
    line-height: 1.8;
  }
  .method-flow {
    position: relative;
    list-style: none;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .method-flow::before {
    content: '';
    position: absolute;
    top: 29px;
    bottom: 29px;
    left: 53.5px;
    width: 1px;
    background: var(--color-line);
  }
  .method-step {
    position: relative;
    display: grid;
    grid-template-columns: 28px 12px minmax(0, 1fr);
    column-gap: 20px;
    align-items: center;
    min-height: 58px;
  }
  .method-step:not(:last-child)::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 80px;
    right: 0;
    height: 1px;
    background: var(--color-line);
    opacity: 0.5;
  }
  .method-number {
    color: var(--color-muted);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }
  .method-node {
    justify-self: center;
    width: 6px;
    height: 6px;
    border: 1px solid var(--color-muted);
    border-radius: 50%;
    background: var(--color-navy);
  }
  .method-label {
    padding-block: 16px;
    padding-right: 40px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.8;
    letter-spacing: 0.035em;
  }
  .method-step--ai .method-label {
    color: var(--color-accent);
    font-weight: 650;
  }
  .method-step--ai .method-node {
    width: 10px;
    height: 10px;
    border-color: var(--color-accent);
    border-radius: 2px;
    background: var(--color-accent);
  }
  .method-step--ai .method-number {
    color: var(--color-accent);
  }
  .method-feedback {
    position: absolute;
    right: 0;
    top: 0;
    color: var(--color-accent);
    stroke: currentColor;
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (max-width: 900px) {
    .engineering-method {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .method-intro h2,
    .method-intro p.section-description {
      max-width: 560px;
    }
  }
  @media (max-width: 760px) {
    .engineering-method--about {
      padding-block: 42px;
    }
    .method-intro .eyebrow {
      margin-bottom: 20px;
    }
    .method-intro p.section-description {
      margin-top: 24px;
    }
    .method-step {
      grid-template-columns: 24px 12px minmax(0, 1fr);
      column-gap: 14px;
    }
    .method-flow::before {
      left: 43.5px;
    }
    .method-step:not(:last-child)::after {
      left: 64px;
    }
    .method-label {
      letter-spacing: 0.01em;
      padding-right: 32px;
    }
  }
</style>
