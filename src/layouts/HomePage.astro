---
import { Picture } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import photo from '../assets/images/profile.png';
import Arrow from '../components/Arrow.astro';
import SystemLines from '../components/SystemLines.astro';
import ProjectList from '../components/ProjectList.astro';
import ArticleList from '../components/ArticleList.astro';
import ExperienceList from '../components/ExperienceList.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { pathFor, otherLocale, type Locale } from '../i18n/routes';
import { t } from '../i18n/translations';
import { projectsFor, articlesFor } from '../lib/content';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = t(locale);
const projects = await projectsFor(locale);
const articles = await articlesFor(locale);
---

<BaseLayout
  locale={locale}
  page="home"
  title={
    locale === 'en'
      ? 'Marcelo Taparelli — Software Engineer & Applied AI'
      : 'Marcelo Taparelli — Engenheiro de Software e IA Aplicada'
  }
  description={text.hero.intro}
  equivalent={pathFor('home', otherLocale(locale))}
>
  <section class="hero container" aria-labelledby="hero-title">
    <SystemLines />
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow">
        <span class="status-dot" aria-hidden="true"></span>
        {text.hero.eyebrow}
        <span class="eyebrow-separator">/</span>MARCELO TAPARELLI
      </p>
      <h1 id="hero-title" lang={locale}>
        <span>{text.hero.title.first}</span>
        <span>
          {text.hero.title.second}
          <span class="hero-period">.</span>
        </span>
        <span class="hero-title-light">{text.hero.title.third}</span>
        <span class="hero-title-light">
          {text.hero.title.fourth}
          <span class="hero-period">.</span>
        </span>
      </h1>
      <p class="hero-intro">{text.hero.intro}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={pathFor('projects', locale)}>
          {text.hero.work}
          <Arrow />
        </a>
        <a class="button button-text" href={pathFor('contact', locale)}>
          {text.hero.contact}
          <Arrow direction="diagonal" />
        </a>
      </div>
    </div>
    <div class="hero-person">
      <div class="portrait-frame">
        <Picture
          src={photo}
          widths={[192, 384]}
          sizes="(max-width: 760px) 112px, (max-width: 1050px) 144px, 176px"
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          width={176}
          height={176}
          alt="Marcelo Taparelli"
          loading="eager"
        />
      </div>
      <p>{text.hero.caption}</p>
      <span class="portrait-rule" aria-hidden="true"></span>
    </div>
    <div class="hero-bottom">
      <p lang="en">
        Software Engineering <span>·</span> Applied AI <span>·</span> Product
      </p>
      <a href="#selected-work" aria-label={text.hero.work}>
        <span aria-hidden="true">↓</span>
      </a>
    </div>
  </section>
  <section
    id="selected-work"
    class="section container"
    aria-labelledby="work-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">{text.work.eyebrow}</p>
        <h2 id="work-title" class="preserve-lines">
          {text.work.title}
        </h2>
      </div>
      <div class="section-heading-aside">
        <p class="section-description">{text.work.description}</p>
        <a class="text-link" href={pathFor('projects', locale)}>
          {text.allProjects}
          <Arrow />
        </a>
      </div>
    </div>
    <ProjectList entries={projects} locale={locale} />
  </section>
  <section class="thinking-section" aria-labelledby="thinking-title">
    <div class="container section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{text.thinking.eyebrow}</p>
          <h2 id="thinking-title" class="preserve-lines">
            {text.thinking.title}
          </h2>
        </div>
        <p class="section-description">{text.thinking.description}</p>
      </div>
      <ol class="thinking-grid">
        {text.thinking.items.map((item, index) => (
          <li>
            <span class="thinking-number" aria-hidden="true">
              0{index + 1}
              <span></span>
            </span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <section
    class="section container experience-section"
    aria-labelledby="experience-title"
  >
    <div>
      <p class="eyebrow">{text.experience.eyebrow}</p>
      <h2 id="experience-title" class="preserve-lines">
        {text.experience.title}
      </h2>
      <p class="section-description">{text.experience.description}</p>
      <a class="text-link" href={pathFor('about', locale)}>
        {text.experience.link}
        <Arrow />
      </a>
    </div>
    <ExperienceList locale={locale} />
  </section>
  {articles.length > 0 && (
    <section
      class="section container writing-section"
      aria-labelledby="writing-title"
    >
      <div class="section-heading">
        <div>
          <p class="eyebrow">{text.writing.eyebrow}</p>
          <h2 id="writing-title">{text.writing.title}</h2>
        </div>
        <a class="text-link" href={pathFor('articles', locale)}>
          {text.allArticles}
          <Arrow />
        </a>
      </div>
      <ArticleList entries={articles.slice(0, 1)} locale={locale} />
    </section>
  )}
  <ContactBlock locale={locale} />
</BaseLayout>
