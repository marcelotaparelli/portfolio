---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { t } from '../i18n/translations';
import { pathFor, otherLocale, type Locale, type Page } from '../i18n/routes';
import { isPreview } from '../lib/content';
import '../styles/global.css';
interface Props {
  locale: Locale;
  page: Page;
  title: string;
  description: string;
  equivalent: string;
  noindex?: boolean;
  article?: boolean;
  structuredData?: Record<string, unknown>;
}
const {
  locale,
  page,
  title,
  description,
  equivalent,
  noindex = false,
  article = false,
  structuredData,
} = Astro.props;
const canonical = new URL(
  page === 'notFound' ? pathFor('notFound', locale) : Astro.url.pathname,
  site.origin,
).href;
const equivalentUrl = new URL(equivalent, site.origin).href;
const image = new URL(
  `/og/${locale === 'en' ? 'en' : 'pt-br'}.png`,
  site.origin,
).href;
const person = {
  '@type': 'Person',
  '@id': `${site.origin}/#person`,
  name: site.name,
  url: site.origin,
  jobTitle: 'Software Engineer',
  sameAs: [site.linkedin, site.github],
};
const graph = [
  person,
  {
    '@type': 'WebSite',
    '@id': `${site.origin}/#website`,
    url: site.origin,
    name: site.name,
    inLanguage: ['pt-BR', 'en'],
  },
  ...(page === 'about'
    ? [
        {
          '@type': 'ProfilePage',
          url: canonical,
          mainEntity: { '@id': `${site.origin}/#person` },
        },
      ]
    : []),
  ...(structuredData ? [structuredData] : []),
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#061321" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {(noindex || isPreview) && (
      <meta name="robots" content="noindex, nofollow" />
    )}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={otherLocale(locale)} href={equivalentUrl} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={locale === 'pt-BR' ? canonical : equivalentUrl}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/inter-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:locale"
      content={locale === 'pt-BR' ? 'pt_BR' : 'en_US'}
    />
    <meta
      property="og:locale:alternate"
      content={locale === 'pt-BR' ? 'en_US' : 'pt_BR'}
    />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${site.name} — From real problems to intelligent products.`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta
      name="twitter:image:alt"
      content={`${site.name} — From real problems to intelligent products.`}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': graph,
      }).replace(/</g, '\\u003c')}
    ></script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t(locale).skip}
    </a>
    <Header locale={locale} page={page} equivalent={equivalent} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
