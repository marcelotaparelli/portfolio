---
import BaseLayout from './BaseLayout.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { pathFor, otherLocale, type Locale } from '../i18n/routes';
import { t } from '../i18n/translations';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = t(locale);
---

<BaseLayout
  locale={locale}
  page="contact"
  title={`${text.nav.contact} — Marcelo Taparelli`}
  description={text.contact.description}
  equivalent={pathFor('contact', otherLocale(locale))}
>
  <ContactBlock locale={locale} standalone />
</BaseLayout>
